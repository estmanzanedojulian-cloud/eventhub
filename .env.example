# EventHub Supabase Environment Variables
# Obtener desde: https://app.supabase.com -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...tu_anon_key

# Service role key (SOLO para uso server-side / admin, NUNCA exponer en cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...tu_service_role_key

# URL pública de la aplicación
NEXT_PUBLIC_SITE_URL=http://localhost:3000
